{
  "name": "foldermark",
  "version": "1.0.0",
  "private": true,
  "description": "Build-time Markdown reader with folder indexes and stable ID routes.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "content:order": "node scripts/update-order-ledger.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/content.test.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "18.0.7",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
